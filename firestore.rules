rules_version = '2';

// Правила Firestore проєкту huntingsignals.
//
// Нові колекції системи доступу (lib/services/access_service.dart):
//   app_access/config  — корпоративні домени, тривалість пробного періоду,
//                        пошти адміністраторів;
//   users/{uid}        — дата першого входу (початок пробного періоду) і
//                        активований код;
//   access_codes/{code}— коди доступу, які створює адміністратор.
//
// Контент (signals, edu_*, global_events, іспити…) читають усі, а змінює
// лише адміністратор — залогінений з підтвердженою поштою зі списку
// app_access/config.adminEmails або головний адміністратор (ROOT_ADMIN у
// site/js/access.js і AccessConfig.rootAdmin у додатку). Користувачі пишуть
// тільки в shared_events (поширені особисті події) та exam_submissions.
//
// Деплой:  firebase login && firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function configPath() {
      return /databases/$(database)/documents/app_access/config;
    }
    // Головний адміністратор має права й до створення app_access/config,
    // тож налаштування не може лишитися без жодного адміністратора.
    function isRootAdmin() {
      return signedIn() && myEmail() == 'volcovskij@forestcollege.ukr.education';
    }
    function isAdmin() {
      return isRootAdmin() || (
        signedIn()
        && exists(configPath())
        && myEmail() in get(configPath()).data.adminEmails
      );
    }
    // Колекції, які змінює лише адміністратор (адмін-панелі сайту й додатку).
    function adminOnly(collection) {
      return collection in [
        'signals', 'materials', 'global_events',
        'edu_topics', 'edu_learning_materials', 'edu_flashcards', 'edu_test_questions',
        'practical_topics', 'practical_materials', 'study_plan', 'exam_sessions',
        'breathing_exercises', 'pokit_species', 'pokit_trainer',
      ];
    }

    // ── Налаштування доступу ────────────────────────────────────────────
    // Читають усі (потрібно до входу — для екрана входу). Створює й змінює
    // лише адміністратор (спершу — головний).
    match /app_access/config {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Користувачі ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Перший вхід: createdAt — лише серверний час, тип доступу — пробний.
      allow create: if isOwner(uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.accessType == 'trial';

      // createdAt змінювати не можна (це початок пробного періоду).
      // Тип доступу міняється тільки на 'code' і тільки в тій самій
      // транзакції, де користувача дописано в usedBy коду (getAfter).
      allow update: if isOwner(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            request.resource.data.accessType == resource.data.accessType
            && request.resource.data.get('accessUntil', null) == resource.data.get('accessUntil', null)
            && request.resource.data.get('codeId', null) == resource.data.get('codeId', null)
          )
          || (
            request.resource.data.accessType == 'code'
            && request.resource.data.codeId is string
            && uid in getAfter(/databases/$(database)/documents/access_codes/$(request.resource.data.codeId)).data.usedBy
          )
        );

      allow delete: if isAdmin();
    }

    // ── Коди доступу ─────────────────────────────────────────────────────
    match /access_codes/{code} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();

      // Звичайний користувач може лише «використати» код: +1 до usedCount,
      // свій uid у usedBy — і тільки поки код активний, не прострочений і
      // має вільні активації. Усе інше — адміністратор.
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.active == true
          && (resource.data.get('expiresAt', null) == null || resource.data.expiresAt > request.time)
          && (resource.data.get('maxUses', 0) == 0 || resource.data.usedCount < resource.data.maxUses)
          && !(request.auth.uid in resource.data.usedBy)
          && request.resource.data.usedCount == resource.data.usedCount + 1
          && request.resource.data.usedBy == resource.data.usedBy.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'usedBy', 'usedByEmails'])
        );
    }

    // ── Іспити: сесії ───────────────────────────────────────────────────
    // Студент читає одну сесію за відомим кодом (нові сесії мають id = код).
    // Запит за полем code з limit(1) лишено для додатку 1.1.x і старих сесій
    // (id = час створення); повний перелік сесій — лише адміністратор.
    match /exam_sessions/{id} {
      allow get: if signedIn();
      allow list: if isAdmin() || (signedIn() && request.query.limit <= 1);
      allow write: if isAdmin();
    }

    // ── Іспити: спроба студента на сайті ───────────────────────────────
    // exam_attempts/{sessionId}_{uid}: одна на студента. Створити — лише
    // свою, «в процесі», із серверним часом старту й поки сесія активна та
    // у вікні доступності. Змінювати — лише свою й лише до здачі; uid,
    // сесію й час старту змінити не можна. Видаляє (анулює) адміністратор.
    match /exam_attempts/{attemptId} {
      // resource == null: студент перевіряє, чи вже починав (документа ще немає)
      allow get: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && attemptId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.startedAt == request.time
        && request.resource.data.get('visibilityLeaves', 0) == 0
        && examOpen(request.resource.data.sessionId);

      allow update: if isAdmin()
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'in_progress'
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.sessionId == resource.data.sessionId
            && request.resource.data.startedAt == resource.data.startedAt
            && request.resource.data.status in ['in_progress', 'submitted']
            && request.resource.data.get('visibilityLeaves', 0) >= resource.data.get('visibilityLeaves', 0));

      allow delete: if isAdmin();
    }

    function examSession(sessionId) {
      return get(/databases/$(database)/documents/exam_sessions/$(sessionId)).data;
    }
    function examOpen(sessionId) {
      let s = examSession(sessionId);
      return s.status == 'active'
        && (s.get('startsAt', null) == null || s.startsAt <= request.time)
        && (s.get('deadline', null) == null || s.deadline > request.time);
    }

    // ── Іспити: роботу здає студент, оцінює адміністратор ──────────────
    match /exam_submissions/{id} {
      // Роботу з сайту (є uid) читає лише її автор і адміністратор; старі
      // роботи з додатку (без uid) — як раніше, будь-хто залогінений за id.
      // Повний перелік робіт сесії ("list") — лише адміністратор; запит
      // «чи вже здавав» з limit(1) лишено для додатку 1.1.x.
      allow get: if isAdmin()
        || (signedIn() && (resource == null || resource.data.get('uid', null) == null || resource.data.uid == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && request.query.limit <= 1);

      // Створити роботу може будь-хто залогінений, але сервер вимагає,
      // щоб вона була щойно подана ("pending", без жодних оцінок
      // адміністратора) і щоб сесія справді існувала й була активною —
      // це не дає студенту напряму записати собі вже «перевірену» роботу
      // з виставленими балами.
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.get('adminTheoryPoints', null) == null
        && request.resource.data.get('adminAudioPoints', null) == null
        && request.resource.data.get('adminFilePoints', null) == null
        && request.resource.data.sessionId is string
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && (
          // з додатку: сесія активна
          (request.resource.data.get('uid', null) == null
            && examSession(request.resource.data.sessionId).status == 'active')
          // з сайту: підсумок власної спроби, у тому самому батчі, що й її
          // здача (id = id спроби) — дозволено й після закриття сесії
          // (автоздача після закриття або дедлайну)
          || (request.resource.data.get('uid', null) == request.auth.uid
            && id == request.resource.data.sessionId + '_' + request.auth.uid
            && getAfter(/databases/$(database)/documents/exam_attempts/$(id)).data.status == 'submitted'
            && get(/databases/$(database)/documents/exam_attempts/$(id)).data.status == 'in_progress')
        );

      // Адміністратор: «Примусово здати» спробу студента
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Результати пробних тестів (самостійна робота практики) ─────────
    // Свій запис створює лише сам студент (uid = свій, серверний час);
    // читає власник і адміністратор; змінює й видаляє лише адміністратор.
    match /quiz_results/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.kind in ['theory', 'audio']
        && request.resource.data.correct is int
        && request.resource.data.total is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Дихальна гімнастика: журнал виконань студента ──────────────────
    // Свій запис створює лише сам студент (uid = свій); читає власник і
    // адміністратор; змінює й видаляє лише адміністратор.
    match /breathing_sessions/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.exerciseId is string
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Покіт: журнал спроб студента (як breathing_sessions) ───────────
    match /pokit_sessions/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.percent is number
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Практика: робота студента (кроки, файли, щоденник, таблиці) ────
    // Один документ на студента (id = uid). Пише лише сам студент і лише
    // дозволені поля (бали тут не зберігаються); читає він і адміністратор.
    match /practice_work/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['uid', 'email', 'fullName', 'group', 'steps', 'diary', 'breath', 'signals', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ── Практика: оцінки викладача ─────────────────────────────────────
    // Бали й коментарі ставить лише адміністратор; студент бачить свої.
    match /practice_grades/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Решта колекцій ──────────────────────────────────────────────────
    // Контент адмін-панелі (adminOnly) змінює лише адміністратор; інші
    // колекції (shared_events тощо) — будь-хто залогінений. Колекції доступу
    // й іспитові роботи тут виключено: для них діють правила вище (правила
    // Firestore об'єднуються через «або», тож інакше вони б їх послабили).
    match /{collection}/{document=**} {
      allow read: if !(collection in ['users', 'access_codes', 'app_access', 'exam_sessions', 'exam_attempts', 'exam_submissions', 'quiz_results', 'breathing_sessions', 'pokit_sessions', 'practice_work', 'practice_grades']);
      allow write: if adminOnly(collection)
                   ? isAdmin()
                   : signedIn() && !(collection in ['users', 'access_codes', 'app_access', 'exam_attempts', 'exam_submissions', 'quiz_results', 'breathing_sessions', 'pokit_sessions', 'practice_work', 'practice_grades']);
    }
  }
}
